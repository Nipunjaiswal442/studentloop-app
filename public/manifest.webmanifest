      "url": "/deliver",
      "icons": [{ "src": "/icons/shortcut-deliver.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Wallet",
      "short_name": "Wallet",
      "description": "Check your balance and top up",
