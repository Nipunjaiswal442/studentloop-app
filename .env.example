# Written automatically by `npx convex dev`. In production Vercel gets it from
# `convex deploy` (see README), so you normally never set it by hand.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Firebase web config, used only for "Continue with Google". Firebase console >
# Project settings > Your apps. Leave these out and the Google button is hidden.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Backend settings (Convex dashboard > Settings > Environment Variables, or
# `npx convex env set NAME value`). They are NOT read from this file.
#   SITE_URL             where the app is served, e.g. https://studentloop-app.vercel.app
#   JWT_PRIVATE_KEY      set by `node scripts/auth-keys.mjs`
#   JWKS                 set by `node scripts/auth-keys.mjs`
#   FIREBASE_PROJECT_ID  the same project id as above; turns Google sign-in on
#   NVIDIA_API_KEY       optional, enables the AI help assistant
