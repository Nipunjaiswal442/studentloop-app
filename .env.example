# Copy to .env.local for local work. On Vercel, set these under
# Settings > Environment Variables instead (README > Deploying).

# Firebase web config: Firebase console > Project settings > General > Your apps.
# These are public values, baked into the site at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Written automatically by `npx convex dev`; on Vercel `convex deploy` supplies it.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Vercel only: a production deploy key from the Convex dashboard (Settings > Deploy keys).
# CONVEX_DEPLOY_KEY=

# Backend settings live on the Convex deployment, not in this file
# (`npx convex env set NAME value`, or the dashboard):
#   FIREBASE_PROJECT_ID   same as VITE_FIREBASE_PROJECT_ID (the Vercel build sets it for you)
#   NVIDIA_API_KEY        optional, turns on the AI help assistant
