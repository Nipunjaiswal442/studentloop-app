# Written automatically by `npx convex dev`. In production Vercel gets it from
# `convex deploy` (see README), so you normally never set it by hand.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Backend settings (Convex dashboard > Settings > Environment Variables, or
# `npx convex env set NAME value`). They are NOT read from this file.
#   SITE_URL            where the app is served, e.g. https://studentloop-app.vercel.app
#   JWT_PRIVATE_KEY     created by `npx @convex-dev/auth`
#   JWKS                created by `npx @convex-dev/auth`
#   AUTH_GOOGLE_ID      optional, enables "Continue with Google"
#   AUTH_GOOGLE_SECRET  optional, enables "Continue with Google"
#   NVIDIA_API_KEY      optional, enables the AI help assistant
